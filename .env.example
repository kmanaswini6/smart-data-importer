# Copy this file to .env for local Docker Compose use.
# Generate unique random values; never commit your real .env file.
MYSQL_ROOT_PASSWORD=replace_with_a_strong_unique_database_password
DB_NAME=smart_data_importer
DB_USER=root
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
GROQ_API_KEY=
# Absolute host path to your Firebase service-account JSON (keep it outside the repo).
FIREBASE_CREDENTIAL_FILE=/absolute/path/to/your/firebase-service-account.json
MYSQL_PORT=3307
PORT=5000
FRONTEND_PORT=8080
