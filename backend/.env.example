# Copy to backend/.env for local development and fill in your own values.
PORT=5000
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=smart_data_importer
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
GROQ_API_KEY=

# Absolute path to a local Firebase service-account JSON file.
# Keep the JSON file outside version control.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/firebase-service-account.json
